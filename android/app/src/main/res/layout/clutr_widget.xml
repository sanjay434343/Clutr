<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_pie_chart"
        android:background="@drawable/widget_icon_background"
        android:padding="16dp"
        android:contentDescription="Icon" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Space to Free"
            android:textColor="@color/widget_text_title"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanning..."
            android:textColor="@color/widget_text_value"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
